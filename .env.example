# ==========================================
# SRI ANJANEYA FURNITURES — ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# CLIENT-SAFE VARIABLES (Exposed in Vite Bundle)
# Prefix with VITE_ to expose to the browser.
# NEVER put service-role keys or provider secrets here!
# ------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_APP_URL=http://localhost:5173
VITE_TURNSTILE_SITE_KEY=

# ------------------------------------------
# SERVER / EDGE FUNCTION SECRETS (SERVER ONLY)
# Configure these in Supabase Dashboard / Edge Functions secrets.
# NEVER expose these to the browser frontend or commit to version control.
# ------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_NOTIFICATION_EMAIL=admin@srianjaneyafurnitures.com
# RESEND_FROM_EMAIL=inquiries@srianjaneyafurnitures.com
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
